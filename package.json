{
  "author": "Jarvis pour Julien Goffaux",
  "build": {
    "appId": "ca.airrichelieu.bibliotheque-aviation",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "asarUnpack": [
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "files": [
      "main.js",
      "main-import.js",
      "main-ai.js",
      "main-update.js",
      "main/**/*",
      "import-core.js",
      "preload.cjs",
      "renderer/**/*",
      "assets/pdfjs/**",
      "assets/tesseract/**",
      "data/synonyms.json",
      "package.json"
    ],
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "hardenedRuntime": false,
      "identity": "-",
      "target": ["dmg", "zip"]
    },
    "productName": "Bibliotheque Aviation",
    "publish": {
      "owner": "juliengoffauxdu60",
      "provider": "github",
      "releaseType": "release",
      "repo": "Bibliotheque-Aviation"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.12",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^6.0.1"
  },
  "description": "Recherche plein texte dans les documents d'aviation (POH, AIM, RAC...), avec lecteur PDF intégré, ajout de documents et OCR. Application desktop Electron, 100 % locale, hors réseau.",
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "bibliotheque-aviation",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/juliengoffauxdu60/Bibliotheque-Aviation.git"
  },
  "scripts": {
    "build": "electron-builder --publish never",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --x64 --arm64 --publish never",
    "selftest": "node scripts/selftest.js",
    "start": "electron .",
    "test": "node test/run-all.mjs"
  },
  "version": "1.2.5",
  "type": "module"
}
